class LoginDialog(QDialog):
    """Renew the session: 2FA code, plus the passwords if Proton rejects them."""

    def __init__(self, app, parent=None):
        super().__init__(parent)
        self.app = app
        self.setWindowTitle(tr("Protux – log in"))
        self.setWindowIcon(drive_qicon())
        head = QHBoxLayout()
        icon = QLabel()
        icon.setPixmap(drive_icon("error", 48))
        head.addWidget(icon)
        txt = QLabel(tr("<b>Your Proton Drive session expired.</b><br>Enter the 6-digit code from your "
                        "authenticator app to connect again."))
        txt.setWordWrap(True)
        head.addWidget(txt, 1)
        self.code = QLineEdit()
        self.code.setMaxLength(8)
        self.code.setPlaceholderText("123456")
        self.no2fa = QCheckBox(tr("My account doesn't use 2FA"))
        self.no2fa.toggled.connect(lambda on: self.code.setEnabled(not on))
        self.password = password_edit()
        self.mailbox = password_edit()
        self.error = error_label()
        self.form = QFormLayout()
        self.form.addRow(tr("2FA code:"), self.code)
        self.form.addRow("", self.no2fa)
        self.form.addRow(tr("Password:"), self.password)
        self.form.addRow(tr("Second password:"), self.mailbox)
        self.form.setRowVisible(2, False)
        self.form.setRowVisible(3, False)
        self.buttons = QDialogButtonBox(QDialogButtonBox.StandardButton.Cancel)
        self.ok = self.buttons.addButton(tr("Log in"), QDialogButtonBox.ButtonRole.AcceptRole)
        self.ok.setDefault(True)
        self.buttons.accepted.connect(self.submit)
        self.buttons.rejected.connect(self.reject)
        lay = QVBoxLayout(self)
        lay.addLayout(head)
        lay.addLayout(self.form)
        lay.addWidget(self.error)
        lay.addWidget(self.buttons)
        self.setMinimumWidth(440)
        self.code.setFocus()

    def submit(self):
        code = re.sub(r"\s", "", self.code.text())
        if not self.no2fa.isChecked() and not re.fullmatch(r"\d{6}", code):
            show_error(self.error, tr("The code must have 6 digits."))
            return
        self.ok.setEnabled(False)
        show_error(self.error, tr("Logging in…"))
        r = self.app.runner
        pw = self.password.text() if self.form.isRowVisible(2) else ""
        mb = self.mailbox.text() if self.form.isRowVisible(3) else ""
        if pw or mb:
            rc, _o, err = r.wait(["__set-credentials"], f"\n{pw}\n{mb}\n")
            if rc != 0:
                return self.failed(1, err)
        rc, _o, err = r.wait(["__login"], ("" if self.no2fa.isChecked() else code) + "\n")
        if rc != EX_OK:
            return self.failed(rc, err)
        show_error(self.error, tr("Mounting…"))
        rc, _o, err = r.wait(["start"])
        if rc != 0:
            return self.failed(rc, err or tr("The drive did not mount."))
        self.app.refresh()
        self.accept()

    def failed(self, rc, err):
        self.ok.setEnabled(True)
        show_error(self.error, login_error(rc, err))
        if rc == EX_PASSWORD:
            self.form.setRowVisible(2, True)
            self.password.setFocus()
        elif rc == EX_MAILBOX:
            self.form.setRowVisible(3, True)
            self.mailbox.setFocus()
        else:
            self.code.clear()
            self.code.setFocus()


class PasswordsDialog(QDialog):
    def __init__(self, app, parent, info):
        super().__init__(parent)
        self.app = app
        self.setWindowTitle(tr("Change passwords"))
        self.setWindowIcon(drive_qicon())
        intro = QLabel(tr("Use this after changing your password at proton.me. Leave a field empty to keep "
                          "what is saved. You will log in again afterwards."))
        intro.setWordWrap(True)
        self.password = password_edit()
        self.two = QCheckBox(tr("My account uses two-password mode (a second password for the mailbox)"))
        self.two.setChecked(info.get("mailbox") == "1")
        self.mailbox = password_edit()
        self.two.toggled.connect(self.mailbox.setEnabled)
        self.mailbox.setEnabled(self.two.isChecked())
        self.error = error_label()
        form = QFormLayout()
        form.addRow(tr("New password:"), self.password)
        form.addRow("", self.two)
        form.addRow(tr("Second password:"), self.mailbox)
        bb = QDialogButtonBox(QDialogButtonBox.StandardButton.Save | QDialogButtonBox.StandardButton.Cancel)
        bb.accepted.connect(self.save)
        bb.rejected.connect(self.reject)
        lay = QVBoxLayout(self)
        lay.addWidget(intro)
        lay.addLayout(form)
        lay.addWidget(self.error)
        lay.addWidget(bb)
        self.setMinimumWidth(460)

    def save(self):
        args = ["__set-credentials"] + ([] if self.two.isChecked() else ["--clear-mailbox"])
        mb = self.mailbox.text() if self.two.isChecked() else ""
        rc, _o, err = self.app.runner.wait(args, f"\n{self.password.text()}\n{mb}\n")
        if rc != 0:
            show_error(self.error, err or tr("Could not save the credentials."))
            return
        self.accept()
        self.app.runner.wait(["stop"])
        self.app.login()


CACHE_MODES = [("off", tr("Off")), ("minimal", tr("Minimal")), ("writes", tr("Writes (recommended)")),
               ("full", tr("Full"))]
LOG_LEVELS = [(x, x) for x in ("ERROR", "NOTICE", "INFO", "DEBUG")]
KEYRING_MODES = [("auto", tr("Automatic (only if the rclone config is encrypted)")), ("yes", tr("Always")),
                 ("no", tr("Never"))]
SIZE_RE = re.compile(r"^(\d+(\.\d+)?[KMGTP]?|off)$", re.I)
DURATION_RE = re.compile(r"^((\d+(\.\d+)?(ms|s|m|min|h|d|w|M|y))+|off)$")
# settings that only take effect when the drive is mounted again
REMOUNT_KEYS = {"MOUNTPOINT", "RCLONE", "RCLONE_CONFIG", "REMOTE", "KEYRING", "CACHE_DIR", "VFS_CACHE_MODE",
                "VFS_CACHE_MAX_SIZE", "VFS_CACHE_MAX_AGE", "VFS_WRITE_BACK", "DIR_CACHE_TIME", "BUFFER_SIZE",
                "UMASK", "ALLOW_OTHER", "LOG_LEVEL", "EXTRA_ARGS"}


class PrefsDialog(QDialog):
    def __init__(self, app, parent):
        super().__init__(parent)
        self.app = app
        self.cfg = parse_kv(cli(["__get-config"])[1])
        self.info = parse_kv(cli(["__info"])[1])
        self.setWindowTitle(tr("Protux preferences"))
        self.setWindowIcon(drive_qicon())
        self.resize(600, 460)
        self.fields = {}       # config key -> (widget, validator)
        tabs = QTabWidget()

        # --- general
        g = QFormLayout()
        self.mountpoint = self._edit("MOUNTPOINT")
        g.addRow(tr("Mount at:"), folder_row(self.mountpoint, self))
        self.auto_mount = QCheckBox(tr("Mount the drive automatically when I log in"))
        self.auto_mount.setChecked(self.info.get("enabled") == "enabled")
        g.addRow("", self.auto_mount)
        self.autostart = QCheckBox(tr("Show Protux in the system tray when I log in"))
        self.autostart.setChecked(app.settings.autostart)
        g.addRow("", self.autostart)
        self.start_hidden = QCheckBox(tr("At startup, show only the tray icon"))
        self.start_hidden.setChecked(app.settings.data.get("start_hidden", True))
        g.addRow("", self.start_hidden)
        self.notify = QCheckBox(tr("Notify when the drive connects or disconnects"))
        self.notify.setChecked(app.settings.data.get("notifications", True))
        g.addRow("", self.notify)
        self.fm = self._edit("FILE_MANAGER")
        self.fm.setPlaceholderText(tr("Automatic (your desktop's file manager)"))
        g.addRow(tr("File manager:"), self.fm)
        self.check_updates = QCheckBox(tr("Check for updates on GitHub once a day"))
        self.check_updates.setChecked(app.settings.data.get("check_updates", True))
        g.addRow("", self.check_updates)
        tabs.addTab(self._page(g), tr("General"))

        # --- account
        a = QFormLayout()
        a.addRow(tr("Email:"), QLabel(self.info.get("username") or "—"))
        a.addRow(tr("Two-password mode:"), QLabel(tr("Yes") if self.info.get("mailbox") == "1" else tr("No")))
        pw = QPushButton(tr("Change passwords…"))
        pw.clicked.connect(lambda: (self.reject(), app.change_passwords()))
        a.addRow("", pw)
        relog = QPushButton(tr("Log in again…"))
        relog.clicked.connect(lambda: (self.reject(), app.login()))
        a.addRow("", relog)
        a.addRow("", QLabel(tr("<small>Remote <b>{0}</b> in {1}</small>").format(
            self.cfg.get("REMOTE", ""), self.cfg.get("RCLONE_CONFIG", ""))))
        tabs.addTab(self._page(a), tr("Account"))

        # --- access
        x = QFormLayout()
        self.allow_other = QCheckBox(tr("Let other users see the drive (root, Docker containers, virtual machines)"))
        self.allow_other.setChecked(self.cfg.get("ALLOW_OTHER") == "yes")
        x.addRow("", self.allow_other)
        if self.info.get("user_allow_other") != "1":
            x.addRow("", QLabel(tr("<small>Needs <code>user_allow_other</code> in /etc/fuse.conf.</small>")))
        x.addRow(tr("Permissions mask:"), self._edit("UMASK", re.compile(r"^[0-7]{3,4}$")))
        tabs.addTab(self._page(x), tr("Access"))

        # --- cache
        c = QFormLayout()
        intro = QLabel(tr("Files are kept on disk while they upload and for quick reopening."))
        intro.setWordWrap(True)
        c.addRow(intro)
        self.cache_mode = combo(CACHE_MODES)
        set_combo(self.cache_mode, self.cfg.get("VFS_CACHE_MODE", "writes"))
        c.addRow(tr("Cache mode:"), self.cache_mode)
        c.addRow(tr("Maximum size:"), self._edit("VFS_CACHE_MAX_SIZE", SIZE_RE, "10G"))
        c.addRow(tr("Keep files for:"), self._edit("VFS_CACHE_MAX_AGE", DURATION_RE, "24h"))
        c.addRow(tr("Upload changes after:"), self._edit("VFS_WRITE_BACK", DURATION_RE, "5s"))
        c.addRow(tr("Refresh folder listings every:"), self._edit("DIR_CACHE_TIME", DURATION_RE, "30s"))
        c.addRow(tr("Read buffer:"), self._edit("BUFFER_SIZE", SIZE_RE, "16M"))
        c.addRow(tr("Cache folder:"), folder_row(self._edit("CACHE_DIR"), self))
        if self.info.get("cache_size"):
            c.addRow(tr("In use:"), QLabel(self.info["cache_size"]))
        tabs.addTab(self._page(c), tr("Cache"))

        # --- advanced
        v = QFormLayout()
        v.addRow(tr("rclone program:"), self._edit("RCLONE"))
        v.addRow(tr("rclone config file:"), self._edit("RCLONE_CONFIG"))
        v.addRow(tr("Remote name:"), self._edit("REMOTE", re.compile(r"^[\w.\- ]+$")))
        self.keyring = combo(KEYRING_MODES)
        set_combo(self.keyring, self.cfg.get("KEYRING", "auto"))
        v.addRow(tr("Config password from the keyring:"), self.keyring)
        v.addRow(tr("Extra rclone flags:"), self._edit("EXTRA_ARGS"))
        self.log_level = combo(LOG_LEVELS)
        set_combo(self.log_level, self.cfg.get("LOG_LEVEL", "INFO"))
        v.addRow(tr("Log level:"), self.log_level)
        v.addRow(tr("Ask again after Proton blocks logins:"), self._edit("RETRY_429_AFTER", DURATION_RE, "65min"))
        tabs.addTab(self._page(v), tr("Advanced"))

        self.error = error_label()
        bb = QDialogButtonBox(QDialogButtonBox.StandardButton.Ok | QDialogButtonBox.StandardButton.Cancel)
        bb.accepted.connect(self.save)
        bb.rejected.connect(self.reject)
        lay = QVBoxLayout(self)
        lay.addWidget(tabs)
        lay.addWidget(self.error)
        lay.addWidget(bb)

    def _page(self, form):
        w = QWidget()
        w.setLayout(form)
        return w

    def _edit(self, key, check=None, placeholder=None):
        e = QLineEdit(self.cfg.get(key, ""))
        if placeholder:
            e.setPlaceholderText(placeholder)
        self.fields[key] = (e, check)
        return e

    def save(self):
        changes = {}
        for key, (w, check) in self.fields.items():
            val = w.text().strip()
            if key != "EXTRA_ARGS" and check and val and not check.match(val):
                show_error(self.error, tr("Invalid value: {0}").format(val))
                w.setFocus()
                return
            if key == "MOUNTPOINT" and not os.path.expanduser(val).startswith("/"):
                show_error(self.error, tr("Use a full path, such as /media/ProtonDrive."))
                w.setFocus()
                return
            if val != self.cfg.get(key, ""):
                changes[key] = os.path.expanduser(val) if key in ("MOUNTPOINT", "CACHE_DIR") else val
        for key, w in (("VFS_CACHE_MODE", self.cache_mode), ("KEYRING", self.keyring), ("LOG_LEVEL", self.log_level)):
            if w.currentData() != self.cfg.get(key):
                changes[key] = w.currentData()
        if self.allow_other.isChecked() != (self.cfg.get("ALLOW_OTHER") == "yes"):
            changes["ALLOW_OTHER"] = "yes" if self.allow_other.isChecked() else "no"
        r = self.app.runner
        if changes:
            rc, _o, err = r.wait(["__set-config", *[x for kv in changes.items() for x in kv]])
            if rc != 0:
                show_error(self.error, err or tr("Could not save"))
                return
        if "MOUNTPOINT" in changes:
            rc, _o, err = r.wait(["__prepare-mountpoint", changes["MOUNTPOINT"]])
            if rc != 0:
                show_error(self.error, err or tr("Could not create {0}").format(changes["MOUNTPOINT"]))
                return
        if self.auto_mount.isChecked() != (self.info.get("enabled") == "enabled"):
            r.wait(["enable" if self.auto_mount.isChecked() else "disable"])
        s = self.app.settings
        s.autostart = self.autostart.isChecked()
        s.data.update(start_hidden=self.start_hidden.isChecked(), notifications=self.notify.isChecked(),
                      check_updates=self.check_updates.isChecked())
        s.save()
        self.accept()
        if REMOUNT_KEYS & changes.keys() and self.app.info.get("mounted") == "1":
            if QMessageBox.question(self.parent(), APP, tr("Mount the drive again now to apply the changes?")) \
                    == QMessageBox.StandardButton.Yes:
                self.app.restart_drive()
        self.app.refresh(full=True)


