def _version_tuple(text):
    return tuple(int(x) for x in re.findall(r"\d+", text or "")[:3]) or (0,)


def system_info(app):
    """Versions and feature usage for bug reports. Never the account, paths or secrets."""
    from PyQt6.QtCore import PYQT_VERSION_STR, QT_VERSION_STR
    info = parse_kv(cli(["__info"])[1])
    distro = "?"
    try:
        with open("/etc/os-release", encoding="utf-8") as f:
            distro = dict(line.rstrip().split("=", 1) for line in f if "=" in line).get("PRETTY_NAME", "?").strip('"')
    except OSError:
        pass
    return "\n".join([
        f"protux: {info.get('version', '?')} ({UI_LANG})",
        f"rclone: {info.get('rclone_version', '?')} (protondrive backend: {info.get('rclone_protondrive', '?')})",
        f"Distro: {distro}",
        f"Kernel: {os.uname().release}",
        f"Desktop: {os.environ.get('XDG_CURRENT_DESKTOP', '?')} ({os.environ.get('XDG_SESSION_TYPE', '?')})",
        f"Python: {sys.version.split()[0]} · Qt: {QT_VERSION_STR} · PyQt: {PYQT_VERSION_STR}",
        f"Mounted: {'yes' if info.get('mounted') == '1' else 'no'} · Service: {info.get('active', '?')} / "
        f"{info.get('enabled', '?')} · State: {info.get('state', '?')}",
        f"Encrypted rclone config: {'yes' if info.get('config_encrypted') == '1' else 'no'} · "
        f"Keyring: {'yes' if info.get('keyring') == '1' else 'no'} · "
        f"Two-password mode: {'yes' if info.get('mailbox') == '1' else 'no'}",
    ])


def _doc_file(name):
    for d in (os.path.join(HERE, ".."), os.path.join(HERE, "..", "share", "doc", "protux"),
              "/usr/share/doc/protux"):
        p = os.path.join(d, name)
        if os.path.exists(p):
            return p
    return None


class Help(QObject):
    update_found = pyqtSignal(str, str)   # version, url

    def __init__(self, app):
        super().__init__(app)
        self.app = app
        self.update_found.connect(self._update_found)

    def _owner(self):
        return self.app.window if self.app.window.isVisible() else None

    def about(self):
        box = QMessageBox(self._owner())
        box.setWindowTitle(tr("About Protux"))
        box.setIconPixmap(drive_icon("up", 96))
        box.setText(f"<h2>Protux {self.app.version}</h2>"
                    + tr("<p><i>Your Proton Drive on Linux — mounted at login, and it stays that way.</i></p>")
                    + tr("<p>Proton Drive for Linux: your drive as a folder, kept mounted by systemd "
                         "and rclone.</p>")
                    + f"<p>© 2026 FrankMncrf — <a href='{REPO_URL}'>{REPO_URL.replace('https://', '')}</a></p>"
                    + tr("<p>Free software under the GPL-3.0 license. No warranty.</p>")
                    + tr("<p><small>Not affiliated with or endorsed by Proton AG. Proton and Proton Drive are "
                         "trademarks of Proton AG.</small></p>"))
        box.setTextFormat(Qt.TextFormat.RichText)
        donate = box.addButton(tr("Donate…"), QMessageBox.ButtonRole.ActionRole)
        lic = box.addButton(tr("Licenses…"), QMessageBox.ButtonRole.ActionRole)
        box.addButton(QMessageBox.StandardButton.Close)
        box.exec()
        if box.clickedButton() is donate:
            self.donate()
        elif box.clickedButton() is lic:
            self.licenses()

    def repo(self):
        open_url(REPO_URL)

    def docs(self):
        open_url(REPO_URL + "#readme")

    def report_bug(self):
        from urllib.parse import urlencode
        q = urlencode({"template": "bug_report.yml", "environment": system_info(self.app)})
        open_url(f"{REPO_URL}/issues/new?{q}")

    def feedback(self):
        open_url(f"{REPO_URL}/discussions/new?category=ideas")

    def copy_info(self):
        QApplication.clipboard().setText(system_info(self.app))
        self.app.notify(tr("System information copied (without your account data)."))

    def donate(self):
        dlg = QDialog(self._owner())
        dlg.setWindowTitle(tr("Support protux"))
        dlg.setWindowIcon(drive_qicon())
        lay = QVBoxLayout(dlg)
        intro = QLabel(tr("protux is free software. If you find it useful, you can support its development:"))
        intro.setWordWrap(True)
        lay.addWidget(intro)
        if DONATE.get("bmc"):
            b = QPushButton("☕  Buy Me a Coffee")
            b.clicked.connect(lambda: open_url(DONATE["bmc"]))
            lay.addWidget(b)
        if DONATE.get("paypal"):
            b = QPushButton("PayPal")
            b.clicked.connect(lambda: open_url(DONATE["paypal"]))
            lay.addWidget(b)
        if DONATE.get("btc"):
            row = QHBoxLayout()
            addr = QLineEdit(DONATE["btc"])
            addr.setReadOnly(True)
            copy = QPushButton(tr("Copy"))
            copy.clicked.connect(lambda: QApplication.clipboard().setText(DONATE["btc"]))
            wallet = QPushButton(tr("Open in my wallet"))
            wallet.clicked.connect(lambda: open_url(f"bitcoin:{DONATE['btc']}?message=protux"))
            row.addWidget(QLabel("₿ Bitcoin:"))
            row.addWidget(addr, 1)
            row.addWidget(copy)
            row.addWidget(wallet)
            lay.addLayout(row)
        star = QPushButton(tr("★  Star it on GitHub"))
        star.clicked.connect(self.repo)
        lay.addWidget(star)
        close = QDialogButtonBox(QDialogButtonBox.StandardButton.Close)
        close.rejected.connect(dlg.reject)
        lay.addWidget(close)
        dlg.setMinimumWidth(460)
        dlg.exec()

    def shortcuts(self):
        w = self.app.window
        rows = "".join(f"<tr><td><b>{a.shortcut().toString(QKeySequence.SequenceFormat.NativeText)}</b></td>"
                       f"<td>{a.text().replace('&', '')}</td></tr>"
                       for a in w.findChildren(QAction) if not a.shortcut().isEmpty())
        usage = cli(["help"])[1]
        TextDialog(self._owner(), tr("Keyboard shortcuts"),
                   f"<h3>{tr('Main window')}</h3><table cellpadding=4>{rows}</table>"
                   f"<h3>{tr('Terminal')}</h3><pre>{usage}</pre>").exec()

    def changelog(self):
        path = _doc_file("CHANGELOG.md")
        try:
            with open(path, encoding="utf-8") as f:
                text = f.read()
        except (OSError, TypeError):
            text = f"[{REPO_URL}/releases]({REPO_URL}/releases)"
        TextDialog(self._owner(), tr("What's new"), text, markdown=True).exec()

    def licenses(self):
        rows = "".join(f"<tr><td><a href='{url}'>{name}</a></td><td>{lic}</td></tr>" for name, lic, url in THIRD_PARTY)
        TextDialog(self._owner(), tr("Licenses"),
                   f"<h3>protux</h3><p>GPL-3.0-or-later — "
                   f"<a href='https://www.gnu.org/licenses/gpl-3.0.html'>gnu.org/licenses/gpl-3.0</a></p>"
                   f"<h3>{tr('Third-party components')}</h3><table cellpadding=4>{rows}</table>"
                   f"<p><small>{tr('Not affiliated with or endorsed by Proton AG.')}</small></p>").exec()

    # --- updates
    def check_updates(self, manual=True):
        def worker():
            try:
                req = urllib.request.Request(RELEASES_API, headers={"User-Agent": f"protux/{self.app.version}",
                                                                    "Accept": "application/vnd.github+json"})
                with urllib.request.urlopen(req, timeout=10) as r:
                    data = json.loads(r.read(200000))
                tag, url = data.get("tag_name", ""), data.get("html_url", REPO_URL + "/releases")
            except (OSError, ValueError):
                tag, url = "", ""
            self.update_found.emit(tag if manual or tag else "", url if tag else ("" if not manual else "error"))

        self.app.settings.data["update_checked"] = time.strftime("%Y-%m-%d")
        self.app.settings.save()
        self._manual = manual
        threading.Thread(target=worker, daemon=True).start()

    def _update_found(self, tag, url):
        manual = getattr(self, "_manual", False)
        if tag and _version_tuple(tag) > _version_tuple(self.app.version):
            msg = tr("There is a new version of protux: {0} (you have {1}).").format(tag, self.app.version)
            if manual:
                box = QMessageBox(self._owner())
                box.setWindowTitle(APP)
                box.setText(msg + "\n\n" + tr("Update it with your distribution's package manager or download "
                                              "it from GitHub."))
                see = box.addButton(tr("See the release"), QMessageBox.ButtonRole.AcceptRole)
                box.addButton(QMessageBox.StandardButton.Close)
                box.exec()
                if box.clickedButton() is see:
                    open_url(url)
            else:
                self.app.notify(msg, 10000)
        elif manual:
            if url == "error":
                QMessageBox.warning(self._owner(), APP, tr("Could not reach GitHub. Check your internet connection."))
            else:
                QMessageBox.information(self._owner(), APP, tr("You have the latest version ({0}).").format(
                    self.app.version))

    def maybe_auto_check(self):
        if self.app.settings.data.get("check_updates", True) and \
                self.app.settings.data.get("update_checked") != time.strftime("%Y-%m-%d"):
            self.check_updates(manual=False)

    def fill_menu(self, m):
        for item in ((tr("Documentation"), self.docs), (tr("Keyboard shortcuts"), self.shortcuts),
                     (tr("What's new"), self.changelog), None,
                     (tr("Report a bug…"), self.report_bug), (tr("Send feedback…"), self.feedback),
                     (tr("Copy system information"), self.copy_info), None,
                     (tr("Check for updates"), self.check_updates),
                     (tr("GitHub repository"), self.repo), (tr("Donate…"), self.donate), None,
                     (tr("Third-party licenses"), self.licenses), (tr("About Protux"), self.about)):
            if item is None:
                m.addSeparator()
            else:
                m.addAction(item[0], (lambda f=item[1]: f()))


# ---------------------------------------------------------------------------
# main window
# ---------------------------------------------------------------------------

class MainWindow(QMainWindow):
    def __init__(self, app):
        super().__init__()
        self.app = app
        self.setWindowTitle(APP)
        self.setWindowIcon(drive_qicon())

        A = self._action
        self.a_toggle = A(tr("Mount"), app.toggle_mount, "Ctrl+M")
        self.a_open = A(tr("Open folder"), lambda: open_folder(app.info.get("mountpoint", "")), "Ctrl+O")
        self.a_login = A(tr("Log in again…"), app.login, "Ctrl+Shift+L")
        self.a_passwords = A(tr("Change passwords…"), app.change_passwords)
        self.a_setup = A(tr("Run the setup wizard…"), app.show_wizard)
        self.a_prefs = A(tr("Preferences…"), app.show_prefs, "Ctrl+,")
        self.a_log = A(tr("Log"), app.show_log, "Ctrl+L")
        self.a_refresh = A(tr("Refresh"), lambda: app.refresh(full=True), "F5")
        self.a_quit = A(tr("Quit"), app.quit, "Ctrl+Q")

        mb = self.menuBar()
        m = mb.addMenu(tr("&File"))
        for a in (self.a_setup, None, self.a_prefs, None, self.a_quit):
            m.addSeparator() if a is None else m.addAction(a)
        m = mb.addMenu(tr("&Drive"))
        for a in (self.a_toggle, self.a_open, None, self.a_login, self.a_passwords):
            m.addSeparator() if a is None else m.addAction(a)
        m = mb.addMenu(tr("&View"))
        m.addAction(self.a_log)
        m.addAction(self.a_refresh)
        app.help.fill_menu(mb.addMenu(tr("&Help")))

        # --- state header
        self.icon = QLabel()
        self.title = QLabel()
        f = self.title.font()
        f.setPointSizeF(f.pointSizeF() * 1.5)
        f.setBold(True)
        self.title.setFont(f)
        self.hint = QLabel()
        self.hint.setWordWrap(True)
        head = QHBoxLayout()
        head.addWidget(self.icon)
        texts = QVBoxLayout()
        texts.addStretch()
        texts.addWidget(self.title)
        texts.addWidget(self.hint)
        texts.addStretch()
        head.addLayout(texts, 1)

        # --- details
        self.d = {}
        details = QGroupBox(tr("Details"))
        form = QFormLayout(details)
        form.setHorizontalSpacing(18)
        form.setVerticalSpacing(6)
        for key, label in (("account", tr("Account")), ("folder", tr("Folder")), ("session", tr("Session")),
                           ("service", tr("Service")), ("autostart", tr("At login")), ("cache", tr("Cache")),
                           ("rclone", "rclone")):
            self.d[key] = QLabel("—")
            self.d[key].setTextInteractionFlags(Qt.TextInteractionFlag.TextSelectableByMouse)
            form.addRow(f"{label}:", self.d[key])

        # --- buttons
        self.toggle_btn = QPushButton(tr("Mount"))
        self.toggle_btn.clicked.connect(self.a_toggle.trigger)
        fm = self.toggle_btn.fontMetrics()
        self.toggle_btn.setMinimumWidth(max(fm.horizontalAdvance(t) for t in (tr("Mount"), tr("Unmount"))) + 32)
        self.open_btn = QPushButton(tr("Open folder"))
        self.open_btn.clicked.connect(self.a_open.trigger)
        self.login_btn = QPushButton(tr("Log in again…"))
        self.login_btn.clicked.connect(self.a_login.trigger)
        prefs = QPushButton(tr("Preferences…"))
        prefs.clicked.connect(self.a_prefs.trigger)
        row = QHBoxLayout()
        row.addWidget(self.toggle_btn)
        row.addWidget(self.open_btn)
        row.addSpacing(12)
        row.addWidget(self.login_btn)
        row.addStretch()
        row.addWidget(prefs)

        lay = QVBoxLayout()
        lay.addLayout(head)
        lay.addSpacing(6)
        lay.addWidget(details)
        lay.addStretch()
        lay.addLayout(row)
        w = QWidget()
        w.setLayout(lay)
        self.setCentralWidget(w)
        self.resize(560, 420)

    def _action(self, text, fn, shortcut=None):
        a = QAction(text, self)
        a.triggered.connect(lambda _=False: fn())
        if shortcut:
            a.setShortcut(QKeySequence(shortcut))
        self.addAction(a)
        return a

    def update_view(self, info, state, busy):
        mounted = state == "up"
        self.icon.setPixmap(drive_icon(state, 64))
        self.title.setText(STATE_LABELS[state])
        st = info.get("state", "unknown")
        if mounted:
            hint = tr("Your files are in {0}.").format(info.get("mountpoint", ""))
        elif state == "error":
            hint = STATE_HINTS.get(st) or info.get("state_msg") or ""
        elif state == "connecting":
            hint = tr("Logging in to Proton and mounting the drive…")
        else:
            hint = tr("The drive is not mounted.")
        self.hint.setText(hint)
        self.d["account"].setText(info.get("username") or "—")
        self.d["folder"].setText(info.get("mountpoint") or "—")
        self.d["session"].setText(tr("Active") if mounted else SESSION_LABELS.get(st, tr("Not logged in")))
        self.d["service"].setText({"active": tr("running"), "inactive": tr("stopped"), "failed": tr("failed"),
                                   "activating": tr("starting")}.get(info.get("active"), info.get("active") or "—"))
        self.d["autostart"].setText(tr("Mounts automatically") if info.get("enabled") == "enabled"
                                    else tr("Mounted by hand"))
        self.d["cache"].setText(info.get("cache_size") or "—")
        self.d["rclone"].setText(info.get("rclone_version") or "—")
        self.a_toggle.setText(tr("Unmount") if mounted else tr("Mount"))
        self.toggle_btn.setText(self.a_toggle.text())
        self.a_toggle.setEnabled(not busy)
        self.toggle_btn.setEnabled(not busy)
        self.a_open.setEnabled(mounted)
        self.open_btn.setEnabled(mounted)
        self.login_btn.setVisible(st in ("auth", "password", "mailbox", "captcha") and not mounted)

    def closeEvent(self, event):
        if QSystemTrayIcon.isSystemTrayAvailable():
            event.ignore()
            self.hide()
        else:
            event.accept()
            self.app.quit()


class LogWindow(TextDialog):
    def __init__(self, parent):
        super().__init__(parent, tr("Log"), "", plain=True, buttons=((tr("Refresh"), self.reload),))
        self.reload()

    def reload(self):
        self.view.setPlainText(cli(["logs", "-n", "300"])[1] or tr("Empty"))
        self.view.moveCursor(self.view.textCursor().MoveOperation.End)


# ---------------------------------------------------------------------------
# the application: tray icon + window
# ---------------------------------------------------------------------------

class Protux(QObject):
    def __init__(self, qapp):
        super().__init__()
        self.qapp = qapp
        self.settings = Settings()
        self.runner = Runner(self)
        qapp.aboutToQuit.connect(self.runner.shutdown)
        self.info = parse_kv(cli(["__info"])[1])
        self.version = self.info.get("version", "")
        self.busy = False
        self.prev_state = None
        self.help = Help(self)
        self.window = MainWindow(self)
        self.wizard = None

        self.tray = QSystemTrayIcon(drive_qicon("down", outline=True))
        self.tray.setToolTip(APP)
        self.menu = QMenu()
        self.tray.setContextMenu(self.menu)
        self.tray.activated.connect(self._tray_activated)
        self.tray.show()
        self.update_view()

        self.timer = QTimer(self)
        self.timer.timeout.connect(self.refresh)
        self.timer.start(POLL_MS)
        QTimer.singleShot(30000, self.help.maybe_auto_check)

    # --- state
    def state(self):
        return drive_state(self.info, self.busy)

    def refresh(self, full=False):
        def done(_rc, out, _err):
            self.info.update(parse_kv(out))
            self.update_view()

        self.runner.run(["__info"] if full else ["__info", "--quick"], done)

    def update_view(self):
        state = self.state()
        if self.prev_state and state != self.prev_state and not self.busy:
            if state == "up":
                self.notify(tr("Proton Drive connected: {0}").format(self.info.get("mountpoint", "")))
            elif self.prev_state == "up":
                self.notify(tr("Proton Drive disconnected."))
        self.prev_state = state
        self.tray.setIcon(drive_qicon(state, outline=True))
        tip = STATE_LABELS[state]
        if state == "up":
            tip += "\n" + self.info.get("mountpoint", "")
        elif state == "error":
            tip += "\n" + SESSION_LABELS.get(self.info.get("state"), "")
        self.tray.setToolTip(f"{APP} – {tip}")
        self.window.update_view(self.info, state, self.busy)
        self._build_menu()

    def notify(self, text, ms=4000):
        if self.settings.data.get("notifications", True) and QSystemTrayIcon.isSystemTrayAvailable():
            self.tray.showMessage(APP, text, drive_qicon(self.state()), ms)

    def _parent(self):
        return self.window if self.window.isVisible() else None

    # --- actions
    def toggle_mount(self):
        mounted = self.info.get("mounted") == "1"
        self.busy = True
        self.update_view()

        def done(rc, _out, err):
            self.busy = False
            self.info.update(parse_kv(cli(["__info", "--quick"])[1]))
            if rc != 0:
                if self.info.get("state") in ("auth", "password", "mailbox"):
                    self.login()
                else:
                    QMessageBox.warning(self._parent(), APP, err or tr("The drive did not mount."))
            self.refresh(full=True)

        self.runner.run(["stop" if mounted else "start"], done)

    def restart_drive(self):
        self.busy = True
        self.update_view()
        self.runner.run(["restart"], lambda *_: (setattr(self, "busy", False), self.refresh(full=True)))

    def login(self):
        LoginDialog(self, self._parent()).exec()
        self.refresh(full=True)

    def change_passwords(self):
        PasswordsDialog(self, self._parent(), self.info).exec()

    def show_prefs(self):
        PrefsDialog(self, self._parent()).exec()

    def show_log(self):
        LogWindow(self._parent()).exec()

    def show_window(self):
        self.window.show()
        self.window.raise_()
        self.window.activateWindow()
        self.refresh(full=True)

    def show_wizard(self):
        if self.wizard and self.wizard.isVisible():
            self.wizard.raise_()
            return
        self.wizard = SetupWizard(self)
        self.wizard.finished.connect(self._wizard_done)
        self.wizard.show()

    def _wizard_done(self, _result):
        self.info.update(parse_kv(cli(["__info"])[1]))
        self.update_view()
        if self.info.get("remote_exists") == "1":
            self.show_window()
        elif not QSystemTrayIcon.isSystemTrayAvailable():
            self.quit()

    def quit(self):
        self.qapp.quit()

    def remote_command(self, cmd):
        if cmd == "login":
            self.login()
        elif cmd == "prefs":
            self.show_prefs()
        elif cmd == "setup":
            self.show_wizard()
        elif cmd != "tray":
            self.show_window()

    # --- tray
    def _build_menu(self):
        m = self.menu
        m.clear()
        state = self.state()
        a = m.addAction(dot_icon(state), STATE_LABELS[state])
        a.setEnabled(False)
        m.addSeparator()
        mounted = state == "up"
        a = m.addAction(tr("Unmount") if mounted else tr("Mount"), self.toggle_mount)
        a.setEnabled(not self.busy)
        a = m.addAction(tr("Open folder"), lambda: open_folder(self.info.get("mountpoint", "")))
        a.setEnabled(mounted)
        if not mounted and self.info.get("state") in ("auth", "password", "mailbox", "captcha"):
            m.addAction(tr("Log in again…"), self.login)
        m.addSeparator()
        m.addAction(tr("Show Protux"), self.show_window)
        m.addAction(tr("View log"), self.show_log)
        m.addAction(tr("Preferences…"), self.show_prefs)
        self.help.fill_menu(m.addMenu(tr("Help")))
        m.addSeparator()
        m.addAction(tr("Quit"), self.quit)

    def _tray_activated(self, reason):
        if reason in (QSystemTrayIcon.ActivationReason.Trigger, QSystemTrayIcon.ActivationReason.DoubleClick):
            if self.window.isVisible() and self.window.isActiveWindow():
                self.window.hide()
            else:
                self.show_window()
        elif reason == QSystemTrayIcon.ActivationReason.MiddleClick and self.info.get("mounted") == "1":
            open_folder(self.info.get("mountpoint", ""))


def main():
    qapp = QApplication(sys.argv)
    qapp.setApplicationName("protux")
    qapp.setApplicationDisplayName(APP)
    qapp.setDesktopFileName("io.github.frankmncrf.protux")
    qapp.setWindowIcon(drive_qicon())
    qapp.setQuitOnLastWindowClosed(False)
    translator = QTranslator(qapp)
    if UI_LANG != "en" and translator.load(QLocale(UI_LANG), "qtbase", "_",
                                           QLibraryInfo.path(QLibraryInfo.LibraryPath.TranslationsPath)):
        qapp.installTranslator(translator)

    cmd = "login" if "--login" in sys.argv else "prefs" if "--preferences" in sys.argv else \
        "setup" if "--setup" in sys.argv else "tray" if "--tray" in sys.argv else "show"
    # single instance: a second launch passes its request to the running one
    sock_name = f"protux-{os.getuid()}"
    probe = QLocalSocket()
    probe.connectToServer(sock_name)
    if probe.waitForConnected(300):
        probe.write(cmd.encode())
        probe.waitForBytesWritten(300)
        return 0
    QLocalServer.removeServer(sock_name)
    server = QLocalServer()
    server.setSocketOptions(QLocalServer.SocketOption.UserAccessOption)
    server.listen(sock_name)

    for _ in range(20):
        if QSystemTrayIcon.isSystemTrayAvailable() or os.environ.get("QT_QPA_PLATFORM") == "offscreen":
            break
        time.sleep(0.5)  # the panel may still be starting at login
    app = Protux(qapp)
    import signal
    signal.signal(signal.SIGTERM, lambda *_: qapp.quit())
    signal.signal(signal.SIGINT, lambda *_: qapp.quit())
    wake = QTimer()
    wake.timeout.connect(lambda: None)  # lets Python run signal handlers while Qt waits
    wake.start(500)

    def incoming():
        conn = server.nextPendingConnection()
        if conn is None:
            return

        def read():
            app.remote_command(bytes(conn.readAll()).decode(errors="replace"))

        conn.readyRead.connect(read)
        conn.disconnected.connect(conn.deleteLater)
        if conn.bytesAvailable():
            read()

    server.newConnection.connect(incoming)
    if app.info.get("remote_exists") != "1":
        app.show_wizard()
    elif cmd == "login":
        QTimer.singleShot(0, app.login)
    elif cmd == "prefs":
        QTimer.singleShot(0, app.show_prefs)
    elif cmd == "setup":
        app.show_wizard()
    elif cmd == "show" or not app.settings.data.get("start_hidden", True) or \
            not QSystemTrayIcon.isSystemTrayAvailable():
        app.show_window()
    return qapp.exec()


if __name__ == "__main__":
    sys.exit(main())
