#!/usr/bin/env python3
"""protux — Proton Drive for Linux: tray icon, window, setup wizard and preferences (PyQt6).

All the work is done by the `protux` command; this is only its face. Secrets are handed to
it through stdin, never as arguments.
"""
import json
import os
import re
import shlex
import subprocess
import sys
import threading
import time
import urllib.request

from PyQt6.QtCore import (QEventLoop, QLibraryInfo, QLocale, QObject, QPointF, QProcess, QRectF, Qt, QTimer,
                          QTranslator, QUrl, pyqtSignal)
from PyQt6.QtGui import (QAction, QColor, QDesktopServices, QFont, QGuiApplication, QIcon, QKeySequence,
                         QLinearGradient, QPainter, QPainterPath, QPen, QPixmap)
from PyQt6.QtNetwork import QLocalServer, QLocalSocket
from PyQt6.QtWidgets import (
    QApplication, QCheckBox, QComboBox, QDialog, QDialogButtonBox, QFileDialog, QFormLayout, QGroupBox,
    QHBoxLayout, QLabel, QLineEdit, QMainWindow, QMenu, QMessageBox, QPlainTextEdit, QPushButton,
    QSystemTrayIcon, QTabWidget, QTextBrowser, QVBoxLayout, QWidget, QWizard, QWizardPage,
)

HERE = os.path.dirname(os.path.realpath(__file__))
LIB = os.environ.get("PROTUX_LIB") or os.path.normpath(os.path.join(HERE, "..", "lib", "protux"))
CLI = os.environ.get("PROTUX_CLI") or (os.path.join(HERE, "protux")
                                           if os.path.exists(os.path.join(HERE, "protux")) else "protux")

# ---------------------------------------------------------------------------
# translations: the source language is English; i18n/<lang>.json maps its strings to other
# languages. The language follows the session (LC_ALL / LC_MESSAGES / LANG).
# ---------------------------------------------------------------------------

UI_LANG = (os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or "en")[:2]
_CATALOG = {}
try:
    with open(os.path.join(LIB, "i18n", f"{UI_LANG}.json"), encoding="utf-8") as _f:
        _CATALOG = json.load(_f)
except (OSError, ValueError):
    pass


def tr(text):
    return _CATALOG.get(text, text)


APP = "Protux"
POLL_MS = 4000
COLORS = {"up": ("#9C84FF", "#5B3BE8"), "connecting": ("#F2C14E", "#C98A12"),
          "down": ("#A3ABB5", "#6B737D"), "error": ("#F26D6D", "#C42B2B")}
SETTINGS_PATH = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
                             "protux", "gui.json")
AUTOSTART_PATH = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
                              "autostart", "io.github.frankmncrf.protux.desktop")

# ---------------------------------------------------------------------------
# icons: a folder with a cloud (data/protux.svg), colored by state like SwanGUI's shield
# ---------------------------------------------------------------------------


def _outline_color():
    app = QGuiApplication.instance()
    dark = app is not None and app.palette().window().color().lightness() < 128
    return "#e6edf3" if dark else "#1b1f24"


def _cloud(s):
    c = QPainterPath()
    c.moveTo(23.5 * s, 47.5 * s)
    c.lineTo(40.7 * s, 47.5 * s)
    c.cubicTo(45 * s, 47.5 * s, 48 * s, 44.2 * s, 48 * s, 40.2 * s)
    c.cubicTo(48 * s, 36.5 * s, 45.3 * s, 33.5 * s, 41.7 * s, 33 * s)
    c.cubicTo(40.4 * s, 28.4 * s, 36.4 * s, 25 * s, 32.4 * s, 25 * s)
    c.cubicTo(27.6 * s, 25 * s, 24 * s, 29.2 * s, 23.6 * s, 35.6 * s)
    c.cubicTo(20.3 * s, 35.6 * s, 17.5 * s, 38.3 * s, 17.5 * s, 41.6 * s)
    c.cubicTo(17.5 * s, 44.9 * s, 20.2 * s, 47.5 * s, 23.5 * s, 47.5 * s)
    c.closeSubpath()
    return c


def drive_icon(state="up", size=64, dim=False, outline=False):
    pm = QPixmap(size, size)
    pm.fill(Qt.GlobalColor.transparent)
    p = QPainter(pm)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)
    s = size / 64
    light, dark = (QColor(c) for c in COLORS[state])
    if dim:
        light, dark = light.lighter(130), dark.lighter(130)
    tab = QPainterPath()
    tab.addRoundedRect(QRectF(6 * s, 10 * s, 52 * s, 16 * s), 5 * s, 5 * s)
    notch = QPainterPath()
    notch.moveTo(29.5 * s, 15 * s)
    notch.lineTo(60 * s, 15 * s)
    notch.lineTo(60 * s, 5 * s)
    notch.lineTo(25 * s, 5 * s)
    notch.closeSubpath()
    tab = tab.subtracted(notch)
    back = QPainterPath()
    back.addRoundedRect(QRectF(6 * s, 13 * s, 52 * s, 12 * s), 5 * s, 5 * s)
    body = QPainterPath()
    body.addRoundedRect(QRectF(6 * s, 19 * s, 52 * s, 37 * s), 6 * s, 6 * s)
    if outline:
        p.setPen(QPen(QColor(_outline_color()), 2 * s))
        p.setBrush(Qt.BrushStyle.NoBrush)
        p.drawPath(tab.united(back).united(body))
    g = QLinearGradient(QPointF(6 * s, 10 * s), QPointF(58 * s, 56 * s))
    g.setColorAt(0, light.darker(118))
    g.setColorAt(1, dark.darker(125))
    p.setPen(Qt.PenStyle.NoPen)
    p.setBrush(g)
    p.drawPath(tab.united(back))
    g = QLinearGradient(QPointF(6 * s, 19 * s), QPointF(58 * s, 56 * s))
    g.setColorAt(0, light)
    g.setColorAt(1, dark)
    p.setBrush(g)
    p.drawPath(body)
    white = QColor("white")
    if state == "up":
        p.setBrush(white)
        p.drawPath(_cloud(s))
    elif state == "connecting":
        p.setBrush(white)
        for x in (22, 32, 42):
            p.drawEllipse(QPointF(x * s, 37 * s), 3.2 * s, 3.2 * s)
    elif state == "error":
        p.setPen(QPen(white, 5 * s, Qt.PenStyle.SolidLine, Qt.PenCapStyle.RoundCap))
        p.drawLine(QPointF(32 * s, 27 * s), QPointF(32 * s, 39 * s))
        p.drawPoint(QPointF(32 * s, 47 * s))
    else:
        p.setPen(QPen(white, 2.6 * s))
        p.setBrush(Qt.BrushStyle.NoBrush)
        p.drawPath(_cloud(s))
    p.end()
    return pm


def drive_qicon(state="up", outline=False):
    icon = QIcon()
    for size in (16, 22, 24, 32, 48, 64, 128):
        icon.addPixmap(drive_icon(state, size, outline=outline and size <= 32))
    return icon


def dot_icon(state):
    pm = QPixmap(14, 14)
    pm.fill(Qt.GlobalColor.transparent)
    p = QPainter(pm)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)
    p.setPen(Qt.PenStyle.NoPen)
    p.setBrush(QColor(COLORS[state][1]))
    p.drawEllipse(1, 1, 12, 12)
    p.end()
    icon = QIcon(pm)
    icon.addPixmap(pm, QIcon.Mode.Disabled)  # the tray menu's status line is disabled: keep its color
    return icon


# ---------------------------------------------------------------------------
# the protux command
# ---------------------------------------------------------------------------

# Exit codes of `protux __login` (ptx_state_exit)
EX_OK, EX_AUTH, EX_RATELIMIT, EX_PASSWORD, EX_MAILBOX, EX_CAPTCHA, EX_CONFIG = 0, 10, 11, 12, 13, 14, 15


def parse_kv(text):
    return dict(line.split("=", 1) for line in text.splitlines() if "=" in line)


def cli(args, stdin=None, timeout=60):
    try:
        p = subprocess.run([CLI, *args], input=stdin, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as e:
        return 127, "", str(e)
    return p.returncode, p.stdout, p.stderr.strip()


class Runner(QObject):
    """Runs protux asynchronously; done(rc, out, err) is called in the GUI thread."""

    def __init__(self, parent=None):
        super().__init__(parent)
        self.procs = set()

    def run(self, args, done=None, stdin=None):
        proc = QProcess(self)
        self.procs.add(proc)

        def finished(code, _status):
            self.procs.discard(proc)
            out = bytes(proc.readAllStandardOutput()).decode(errors="replace")
            err = bytes(proc.readAllStandardError()).decode(errors="replace").strip()
            proc.deleteLater()
            if done:
                done(code, out, err)

        def failed(e):
            if e == QProcess.ProcessError.FailedToStart and done:
                done(127, "", tr("Cannot run protux"))

        proc.finished.connect(finished)
        proc.errorOccurred.connect(failed)
        proc.start(CLI, args)
        if stdin is not None:
            proc.write(stdin.encode())
        proc.closeWriteChannel()
        return proc

    def shutdown(self):
        """Before quitting: a QProcess destroyed while running waits for it and then calls back
        into Python that is already shutting down, which aborts the interpreter."""
        for proc in list(self.procs):
            for sig in (proc.finished, proc.errorOccurred):
                try:
                    sig.disconnect()
                except TypeError:
                    pass
            proc.kill()
            proc.waitForFinished(1000)
        self.procs.clear()

    def wait(self, args, stdin=None):
        """Like run(), but returns (rc, out, err) while the GUI keeps repainting."""
        loop, res = QEventLoop(), []
        self.run(args, lambda *r: (res.extend(r), loop.quit()), stdin)
        if not res:
            loop.exec()
        return tuple(res)


def login_error(rc, err):
    return {EX_AUTH: tr("The 2FA code is wrong or expired."),
            EX_PASSWORD: tr("Proton rejected the password."),
            EX_MAILBOX: tr("This account needs its second (mailbox) password."),
            EX_RATELIMIT: tr("Proton is limiting login attempts. Wait about an hour before trying again."),
            EX_CAPTCHA: tr("Proton asks for a human verification. Log in once at proton.me from this network, "
                           "then try again."),
            EX_CONFIG: tr("Wrong password for the rclone config file (protux keyring set).")
            }.get(rc, err or tr("Unknown error"))


STATE_LABELS = {"up": tr("Connected"), "connecting": tr("Connecting…"), "down": tr("Not connected"),
                "error": tr("Needs attention")}
SESSION_LABELS = {"ok": tr("Active"), "auth": tr("Expired: log in again"),
                  "ratelimit": tr("Proton is limiting logins"), "password": tr("Password rejected"),
                  "mailbox": tr("Second password needed"), "captcha": tr("Human verification required"),
                  "config": tr("Wrong rclone config password")}
STATE_HINTS = {"auth": tr("The Proton session expired. Log in again with your 2FA code."),
               "ratelimit": tr("Proton is limiting logins for a while; you will be asked again later."),
               "password": tr("Proton rejected the password. Update it in Preferences → Account."),
               "mailbox": tr("This account needs its second (mailbox) password."),
               "captcha": tr("Proton asks for a human verification. Log in once at proton.me from this network."),
               "config": tr("The password of the rclone config file is wrong (protux keyring set).")}


def drive_state(info, busy=False):
    if info.get("mounted") == "1":
        return "up"
    if busy or info.get("active") in ("activating", "deactivating", "reloading"):
        return "connecting"
    if info.get("state") not in (None, "", "ok", "unknown"):
        return "error"
    return "down"


def open_folder(path):
    # `protux open` uses the desktop's own file manager (Thunar, Dolphin, Files...), not the
    # default application for folders, which may be one the user never chose
    QProcess.startDetached(CLI, ["open", path])


def open_url(url):
    QDesktopServices.openUrl(QUrl(url))


# ---------------------------------------------------------------------------
# small widgets and settings
# ---------------------------------------------------------------------------

class Settings:
    """Settings of the window and the tray icon (the drive's own are in ~/.config/protux/config)."""

    def __init__(self):
        self.data = {"notifications": True, "start_hidden": True, "check_updates": True}
        try:
            with open(SETTINGS_PATH, encoding="utf-8") as f:
                self.data.update(json.load(f))
        except (OSError, ValueError):
            pass

    def save(self):
        os.makedirs(os.path.dirname(SETTINGS_PATH), exist_ok=True)
        tmp = SETTINGS_PATH + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(self.data, f, indent=2)
        os.replace(tmp, SETTINGS_PATH)

    @property
    def autostart(self):
        return os.path.exists(AUTOSTART_PATH)

    @autostart.setter
    def autostart(self, on):
        if on:
            os.makedirs(os.path.dirname(AUTOSTART_PATH), exist_ok=True)
            exe = os.path.realpath(__file__)
            with open(AUTOSTART_PATH, "w", encoding="utf-8") as f:
                f.write("[Desktop Entry]\nType=Application\nName=Protux\n"
                        f"Exec={shlex.quote(exe)} --tray\nIcon=protux\nTerminal=false\nNoDisplay=true\n"
                        "X-GNOME-Autostart-Delay=5\n")
        elif os.path.exists(AUTOSTART_PATH):
            os.unlink(AUTOSTART_PATH)


def combo(items):
    c = QComboBox()
    for key, label in items:
        c.addItem(label, key)
    return c


def set_combo(c, key):
    i = c.findData(key)
    c.setCurrentIndex(i if i >= 0 else 0)


def error_label():
    lbl = QLabel()
    lbl.setWordWrap(True)
    lbl.setStyleSheet("color: #c42b2b;")
    lbl.hide()
    return lbl


def show_error(lbl, text):
    lbl.setText(text or "")
    lbl.setVisible(bool(text))


def folder_row(edit, parent):
    row = QHBoxLayout()
    row.addWidget(edit, 1)
    b = QPushButton(tr("Browse…"))

    def pick():
        d = QFileDialog.getExistingDirectory(parent, tr("Choose a folder"), edit.text() or os.path.expanduser("~"))
        if d:
            edit.setText(d)

    b.clicked.connect(pick)
    row.addWidget(b)
    return row


def password_edit():
    e = QLineEdit()
    e.setEchoMode(QLineEdit.EchoMode.Password)
    return e


class TextDialog(QDialog):
    """Read-only rich/markdown/plain text with optional extra buttons."""

    def __init__(self, parent, title, text, markdown=False, plain=False, buttons=()):
        super().__init__(parent)
        self.setWindowTitle(title)
        self.setWindowIcon(drive_qicon())
        self.resize(680, 520)
        if plain:
            self.view = QPlainTextEdit(text)
            self.view.setReadOnly(True)
            self.view.setFont(QFont("monospace"))
        else:
            self.view = QTextBrowser()
            self.view.setOpenExternalLinks(True)
            self.view.setMarkdown(text) if markdown else self.view.setHtml(text)
        row = QHBoxLayout()
        for label, fn in buttons:
            b = QPushButton(label)
            b.clicked.connect(fn)
            row.addWidget(b)
        row.addStretch()
        close = QPushButton(tr("Close"))
        close.clicked.connect(self.accept)
        row.addWidget(close)
        lay = QVBoxLayout(self)
        lay.addWidget(self.view)
        lay.addLayout(row)


# ---------------------------------------------------------------------------
# setup wizard
# ---------------------------------------------------------------------------

class IntroPage(QWizardPage):
    def __init__(self, info):
        super().__init__()
        self.setTitle(tr("Welcome to Protux"))
        self.setSubTitle(tr("Your Proton Drive as a folder on this computer. Let's connect your account."))
        lay = QVBoxLayout(self)
        self.ok = True
        box = QGroupBox(tr("Requirements"))
        form = QFormLayout(box)
        for good, name, detail in ((info.get("rclone_protondrive") == "1", "rclone",
                                    info.get("rclone_version") or tr("not found or too old (1.64 or newer needed)")),
                                   (info.get("fuse") == "1", "FUSE", "/dev/fuse")):
            mark = QLabel(("✓  " if good else "✗  ") + detail)
            mark.setStyleSheet(f"color: {'#2ea043' if good else '#c42b2b'};")
            form.addRow(f"{name}:", mark)
            self.ok = self.ok and good
        lay.addWidget(box)
        lay.addStretch()

    def isComplete(self):
        return self.ok


class AccountPage(QWizardPage):
    def __init__(self, wizard, info):
        super().__init__()
        self.wiz, self.info = wizard, info
        exists = info.get("remote_exists") == "1"
        self.setTitle(tr("Proton account"))
        self.setSubTitle(tr("Leave the passwords empty to keep the ones already saved.") if exists
                         else tr("The same email and password you use at proton.me."))
        self.email = QLineEdit(info.get("username", ""))
        self.password = password_edit()
        self.two = QCheckBox(tr("My account uses two-password mode (a second password for the mailbox)"))
        self.two.setChecked(info.get("mailbox") == "1")
        self.mailbox = password_edit()
        self.mailbox_label = QLabel(tr("Second password:"))
        self.two.toggled.connect(self._two)
        self.error = error_label()
        form = QFormLayout(self)
        form.addRow(tr("Email:"), self.email)
        form.addRow(tr("Password:"), self.password)
        form.addRow("", self.two)
        form.addRow(self.mailbox_label, self.mailbox)
        form.addRow("", self.error)
        note = QLabel(tr("<small>The passwords are kept obscured in the rclone config file. Encrypt that "
                         "file and keep its password in the keyring for real protection.</small>"))
        note.setWordWrap(True)
        form.addRow("", note)
        self._two(self.two.isChecked())
        self.focus = self.email

    def _two(self, on):
        self.mailbox.setVisible(on)
        self.mailbox_label.setVisible(on)

    def initializePage(self):
        QTimer.singleShot(0, self.focus.setFocus)

    def validatePage(self):
        email, pw = self.email.text().strip(), self.password.text()
        mb = self.mailbox.text() if self.two.isChecked() else ""
        exists = self.info.get("remote_exists") == "1"
        if not exists and (not email or not pw):
            show_error(self.error, tr("Email and password are required."))
            return False
        if self.two.isChecked() and not mb and self.info.get("mailbox") != "1":
            show_error(self.error, tr("Enter the second password."))
            self.mailbox.setFocus()
            return False
        show_error(self.error, None)
        args = ["__set-credentials"] + ([] if self.two.isChecked() else ["--clear-mailbox"])
        rc, _out, err = self.wiz.runner.wait(args, f"{email}\n{pw}\n{mb}\n")
        if rc != 0:
            show_error(self.error, err or tr("Could not save the credentials."))
            return False
        self.info["remote_exists"] = "1"
        if mb:
            self.info["mailbox"] = "1"
        return True

    def point_at(self, rc, err):
        """Back here after a login error, with the cursor in the field that's wrong."""
        show_error(self.error, login_error(rc, err))
        if rc == EX_MAILBOX:
            self.two.setChecked(True)
            self.mailbox.clear()
            self.focus = self.mailbox
        else:
            self.password.clear()
            self.focus = self.password
        self.focus.setFocus()


class VerifyPage(QWizardPage):
    def __init__(self, wizard):
        super().__init__()
        self.wiz = wizard
        self.setTitle(tr("Verification"))
        self.setSubTitle(tr("Enter the 6-digit code from your authenticator app."))
        self.code = QLineEdit()
        self.code.setMaxLength(8)
        self.code.setPlaceholderText("123456")
        self.no2fa = QCheckBox(tr("My account doesn't use 2FA"))
        self.no2fa.toggled.connect(lambda on: self.code.setEnabled(not on))
        self.error = error_label()
        form = QFormLayout(self)
        form.addRow(tr("2FA code:"), self.code)
        form.addRow("", self.no2fa)
        form.addRow("", self.error)

    def initializePage(self):
        self.code.clear()
        show_error(self.error, None)
        QTimer.singleShot(0, self.code.setFocus)

    def validatePage(self):
        code = re.sub(r"\s", "", self.code.text())
        if not self.no2fa.isChecked() and not re.fullmatch(r"\d{6}", code):
            show_error(self.error, tr("The code must have 6 digits."))
            return False
        show_error(self.error, tr("Connecting…"))
        self.wiz.button(QWizard.WizardButton.NextButton).setEnabled(False)
        QApplication.setOverrideCursor(Qt.CursorShape.WaitCursor)
        try:
            rc, _out, err = self.wiz.runner.wait(["__login"], ("" if self.no2fa.isChecked() else code) + "\n")
        finally:
            QApplication.restoreOverrideCursor()
            self.wiz.button(QWizard.WizardButton.NextButton).setEnabled(True)
        if rc in (EX_PASSWORD, EX_MAILBOX):
            show_error(self.error, None)
            QTimer.singleShot(0, lambda: (self.wiz.back(), self.wiz.account.point_at(rc, err)))
            return False
        if rc != EX_OK:
            show_error(self.error, login_error(rc, err))
            self.code.clear()
            self.code.setFocus()
            return False
        show_error(self.error, None)
        return True


class FolderPage(QWizardPage):
    def __init__(self, wizard, settings):
        super().__init__()
        self.wiz = wizard
        self.setTitle(tr("Folder"))
        self.setSubTitle(tr("Where your Proton Drive files will appear."))
        self.path = QLineEdit(settings.get("MOUNTPOINT", "/media/ProtonDrive"))
        self.auto = QCheckBox(tr("Mount the drive automatically when I log in"))
        self.auto.setChecked(True)
        self.tray = QCheckBox(tr("Show Protux in the system tray when I log in"))
        self.tray.setChecked(True)
        self.error = error_label()
        form = QFormLayout(self)
        form.addRow(tr("Mount at:"), folder_row(self.path, self))
        hint = QLabel(tr("<small>A folder in a system location such as /media is created once with your "
                         "administrator password, and then belongs to you.</small>"))
        hint.setWordWrap(True)
        form.addRow("", hint)
        form.addRow("", self.auto)
        form.addRow("", self.tray)
        form.addRow("", self.error)

    def validatePage(self):
        path = os.path.expanduser(self.path.text().strip())
        if not path.startswith("/"):
            show_error(self.error, tr("Use a full path, such as /media/ProtonDrive."))
            return False
        r = self.wiz.runner
        QApplication.setOverrideCursor(Qt.CursorShape.WaitCursor)
        try:
            rc, _o, err = r.wait(["__set-config", "MOUNTPOINT", path])
            if rc == 0:
                rc, _o, err = r.wait(["__prepare-mountpoint", path])
            if rc == 0:
                r.wait(["enable" if self.auto.isChecked() else "disable"])
                show_error(self.error, tr("Mounting…"))
                rc, _o, err = r.wait(["start"])
        finally:
            QApplication.restoreOverrideCursor()
        if rc != 0:
            show_error(self.error, err or tr("The drive did not mount."))
            return False
        self.wiz.app.settings.autostart = self.tray.isChecked()
        self.wiz.mountpoint = path
        show_error(self.error, None)
        return True


class DonePage(QWizardPage):
    def __init__(self, wizard):
        super().__init__()
        self.wiz = wizard
        self.setTitle(tr("All set"))
        self.text = QLabel()
        self.text.setWordWrap(True)
        b = QPushButton(tr("Open folder"))
        b.clicked.connect(lambda: open_folder(self.wiz.mountpoint))
        lay = QVBoxLayout(self)
        lay.addWidget(self.text)
        row = QHBoxLayout()
        row.addWidget(b)
        row.addStretch()
        lay.addLayout(row)
        lay.addStretch()

    def initializePage(self):
        self.text.setText(tr("Your files are in {0}.").format(self.wiz.mountpoint)
                          + "\n\n" + tr("Protux keeps an eye on the drive from the system tray."))


class SetupWizard(QWizard):
    def __init__(self, app, parent=None):
        super().__init__(parent)
        self.app, self.runner = app, app.runner
        self.mountpoint = ""
        info = parse_kv(cli(["__info"])[1])
        settings = parse_kv(cli(["__get-config"])[1])
        self.setWindowTitle(tr("Protux setup"))
        self.setWindowIcon(drive_qicon())
        self.setPixmap(QWizard.WizardPixmap.LogoPixmap, drive_icon("up", 64))
        self.setOption(QWizard.WizardOption.NoBackButtonOnLastPage, True)
        self.setOption(QWizard.WizardOption.NoCancelButtonOnLastPage, True)
        self.account = AccountPage(self, info)
        for page in (IntroPage(info), self.account, VerifyPage(self), FolderPage(self, settings), DonePage(self)):
            self.addPage(page)
        self.resize(640, 480)


